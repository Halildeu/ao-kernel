{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:ao-ma-10-high-risk-supersession-evidence:v1",
  "title": "AO-MA-10 High-Risk Supersession Evidence",
  "description": "A no-secret, context-bound evidence artifact for a future high-risk autonomous supersession path. This artifact is evidence only; release authority remains ao-release-gate plus GitHub enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "generated_at",
    "repo",
    "work_package",
    "planning_only",
    "release_authority",
    "ai_output_release_authority",
    "guard_flags",
    "context_binding",
    "reviewer_providers",
    "required_reviewer_providers",
    "provider_verdicts",
    "consensus_status",
    "max_revise_rounds",
    "escalation_action",
    "freshness",
    "secrets_recorded",
    "mutations_performed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ao-ma-10-high-risk-supersession-evidence.v1"
    },
    "artifact_kind": {
      "type": "string",
      "const": "ao_ma_10_high_risk_supersession_evidence"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repo": {
      "type": "string",
      "const": "Halildeu/ao-kernel"
    },
    "work_package": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Za-z0-9][A-Za-z0-9._]*)*$",
      "description": "Reviewed work-package identifier for this high-risk supersession evidence. Bound at runtime by the trusted-base workflow from the root local-ai-review-evidence.v1 file's work_package field; passed to the script via --review-work-package and stamped into this artifact. Multi-work-package (governance migration 2026-06-02): any well-formed identifier matching the workflow canonical regex is accepted; per-PR authority is enforced by the live context binding (head_sha, diff_digest, changed_files, refs, repo, high_risk_changed_paths), provider distinctness, unanimous AGREE, freshness, and guard-flag closure — not by an allowlist on this field. Pattern matches .github/workflows/test.yml reviewed_wp regex so identifiers round-trip between root reviewer evidence, payload.reviewed_slice, and this artifact."
    },
    "planning_only": {
      "type": "boolean",
      "const": true
    },
    "release_authority": {
      "type": "string",
      "const": "ao-release-gate+github-ruleset"
    },
    "ai_output_release_authority": {
      "type": "boolean",
      "const": false
    },
    "guard_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_widening",
        "production_platform_claim",
        "live_adapter_execution"
      ],
      "properties": {
        "support_widening": {
          "type": "boolean",
          "const": false
        },
        "production_platform_claim": {
          "type": "boolean",
          "const": false
        },
        "live_adapter_execution": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "context_binding": {
      "$ref": "#/$defs/context_binding"
    },
    "reviewer_providers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/provider_id"
      },
      "contains": {
        "const": "openai"
      },
      "allOf": [
        {
          "contains": {
            "const": "anthropic"
          }
        }
      ]
    },
    "required_reviewer_providers": {
      "type": "array",
      "prefixItems": [
        {
          "const": "openai"
        },
        {
          "const": "anthropic"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "provider_verdicts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/provider_verdict"
      }
    },
    "consensus_status": {
      "type": "string",
      "const": "AGREE"
    },
    "max_revise_rounds": {
      "type": "integer",
      "const": 3
    },
    "escalation_action": {
      "type": "string",
      "const": "operator_human_review_fallback"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "max_age_seconds"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "fresh"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "secrets_recorded": {
      "type": "boolean",
      "const": false
    },
    "mutations_performed": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "provider_id": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "minimax"
      ]
    },
    "context_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_full_name",
        "base_ref",
        "head_ref",
        "head_sha",
        "diff_digest",
        "changed_files_count",
        "high_risk_changed_paths"
      ],
      "properties": {
        "repository_full_name": {
          "type": "string",
          "const": "Halildeu/ao-kernel"
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "head_ref": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "diff_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "changed_files_count": {
          "type": "integer",
          "minimum": 1
        },
        "high_risk_changed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provider_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "provider_id",
        "agent_id",
        "role",
        "risk_classification",
        "verdict",
        "round_index",
        "context_binding",
        "binding_mode",
        "findings_count",
        "secrets_recorded",
        "support_widening",
        "production_platform_claim",
        "live_adapter_execution",
        "release_authority",
        "ai_output_release_authority"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "ao-ma-10-provider-consensus.v1"
        },
        "artifact_kind": {
          "type": "string",
          "const": "ao_ma_10_provider_consensus"
        },
        "provider_id": {
          "$ref": "#/$defs/provider_id"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "reviewer",
            "verifier"
          ]
        },
        "risk_classification": {
          "type": "string",
          "const": "high"
        },
        "verdict": {
          "type": "string",
          "const": "AGREE"
        },
        "round_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "context_binding": {
          "$ref": "#/$defs/context_binding"
        },
        "binding_mode": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "unchanged"
          ],
          "description": "Classification of raw reviewer evidence file's appearance in this PR's diff. 'added' = introducer PR (first commit that lands the evidence file). 'modified' = touched in this PR (current-PR strict binding required to prevent stale-rebind / PR-head tampering). 'unchanged' = not in this PR's diff (state-at-landing pin; scope binding relaxed; immutable properties still enforced)."
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0
        },
        "secrets_recorded": {
          "type": "boolean",
          "const": false
        },
        "support_widening": {
          "type": "boolean",
          "const": false
        },
        "production_platform_claim": {
          "type": "boolean",
          "const": false
        },
        "live_adapter_execution": {
          "type": "boolean",
          "const": false
        },
        "release_authority": {
          "type": "string",
          "const": "ao-release-gate+github-ruleset"
        },
        "ai_output_release_authority": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
