{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:ao-ma-10-low-risk-autonomous-merge-lane:v1",
  "title": "AO-MA-10 Low-Risk Autonomous Merge Lane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "decision",
    "planning_only",
    "release_authority",
    "ai_output_release_authority",
    "support_widening",
    "production_platform_claim",
    "live_adapter_execution",
    "low_risk_criteria",
    "high_risk_consensus",
    "merge_agent_activation_prerequisites",
    "future_slices",
    "forbidden_in_this_slice"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ao-ma-10-low-risk-autonomous-merge-lane.v1"
    },
    "artifact_kind": {
      "type": "string",
      "const": "ao_ma_10_low_risk_autonomous_merge_lane"
    },
    "decision": {
      "type": "string",
      "const": "plan_low_risk_autonomous_merge_lane_cutover"
    },
    "planning_only": {
      "type": "boolean",
      "const": true
    },
    "release_authority": {
      "type": "string",
      "const": "ao-release-gate+github-ruleset"
    },
    "ai_output_release_authority": {
      "type": "boolean",
      "const": false
    },
    "support_widening": {
      "type": "boolean",
      "const": false
    },
    "production_platform_claim": {
      "type": "boolean",
      "const": false
    },
    "live_adapter_execution": {
      "type": "boolean",
      "const": false
    },
    "low_risk_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_path_prefixes",
        "prohibited_path_patterns",
        "required_signals"
      ],
      "properties": {
        "allowed_path_prefixes": {
          "type": "array",
          "items": { "type": "string" },
          "const": [
            ".claude/plans/AO-MA-",
            "ao_kernel/defaults/schemas/ao-ma-",
            "tests/test_ao_ma",
            "tests/fixtures/ao_ma_",
            "docs/evidence/",
            "local-ai-review-evidence.v1.json"
          ]
        },
        "prohibited_path_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "const": [
            "^\\.github/",
            "^\\.github/CODEOWNERS$",
            "^AGENTS\\.md$",
            "^CLAUDE\\.md$",
            "^\\.claude/plans/gpp_status\\.v1\\.json$",
            "^ao_kernel/orchestration/",
            "^ao_kernel/ao_release_gate",
            "^scripts/ao_release_gate",
            "^scripts/local_gpp_gate",
            "^ao_kernel/defaults/schemas/local-ai-review-evidence\\.schema\\.v1\\.json$",
            "^ao_kernel/defaults/schemas/local-gpp-gate-evidence\\.schema\\.v1\\.json$",
            "^ao_kernel/defaults/schemas/ao-release-gate",
            "^deploy/",
            "^pyproject\\.toml$",
            "^ao_kernel/__init__\\.py$",
            "^docs/SUPPORT-BOUNDARY\\.md$",
            "^docs/PUBLIC-BETA\\.md$",
            "^docs/KNOWN-BUGS\\.md$"
          ]
        },
        "required_signals": {
          "type": "array",
          "items": { "type": "string" },
          "const": [
            "required_ci_pass",
            "ao_release_gate_success",
            "branch_up_to_date",
            "context_bound_cross_provider_review_agree",
            "verifier_pass",
            "local_gpp_gate_accepts",
            "secret_scan_pass",
            "no_admin_bypass",
            "no_bypass_actors",
            "no_support_widening",
            "no_production_platform_claim",
            "no_live_adapter_execution"
          ]
        }
      }
    },
    "high_risk_consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_providers",
        "consensus_required",
        "same_provider_review_allowed",
        "max_autonomous_rounds",
        "escalate_to_human_after_max_rounds"
      ],
      "properties": {
        "required_providers": {
          "type": "array",
          "items": { "type": "string" },
          "const": ["openai", "anthropic", "minimax"]
        },
        "consensus_required": {
          "type": "boolean",
          "const": true
        },
        "same_provider_review_allowed": {
          "type": "boolean",
          "const": false
        },
        "max_autonomous_rounds": {
          "type": "integer",
          "const": 3
        },
        "escalate_to_human_after_max_rounds": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "merge_agent_activation_prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "low_risk_classifier_implemented",
              "codeowners_or_ruleset_low_risk_model_implemented",
              "merge_agent_identity_and_permissions_recorded",
              "positive_low_risk_autonomous_merge_smoke",
              "negative_high_risk_blocked_smoke",
              "stale_evidence_blocked_smoke",
              "same_provider_review_blocked_smoke",
              "missing_verifier_blocked_smoke",
              "admin_bypass_absence_verified",
              "cutover_record_no_support_widening_no_production_claim_no_live_adapter"
            ]
          },
          "status": {
            "type": "string",
            "const": "not_started"
          }
        }
      }
    },
    "future_slices": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "forbidden_in_this_slice": {
      "type": "array",
      "items": { "type": "string" },
      "const": [
        "workflow_mutation",
        "ruleset_mutation",
        "codeowners_mutation",
        "release_gate_runtime_mutation",
        "local_gate_runtime_mutation",
        "gpp_status_mutation",
        "merge_agent_activation",
        "auto_merge_execution",
        "testai_or_smee_or_webhook_callback_work"
      ]
    }
  }
}
