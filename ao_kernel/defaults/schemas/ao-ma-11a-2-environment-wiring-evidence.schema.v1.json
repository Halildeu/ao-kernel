{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:ao-ma-11a-2-environment-wiring-evidence:v1",
  "title": "AO-MA-11A-2 Environment Wiring Evidence",
  "description": "Evidence that the GitHub Environment used by the AO-MA-11A plan approval gate exists and is configured as the single operator approval surface. Evidence only; release authority remains ao-release-gate plus the GitHub ruleset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "repository_full_name",
    "environment_name",
    "environment_id",
    "environment_api_url",
    "environment_html_url",
    "observed_at",
    "observation_source",
    "environment_exists",
    "required_reviewers_count",
    "required_reviewers",
    "prevent_self_review",
    "can_admins_bypass",
    "workflow_path",
    "workflow_sha256",
    "plan_doc_path",
    "plan_doc_sha256",
    "gate_cli_path",
    "gate_cli_sha256",
    "gate_report_schema_path",
    "gate_report_schema_sha256",
    "release_authority",
    "ai_output_release_authority",
    "secrets_recorded",
    "support_widening",
    "production_platform_claim",
    "live_adapter_execution"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ao-ma-11a-2-environment-wiring-evidence.v1"
    },
    "artifact_kind": {
      "type": "string",
      "const": "ao_ma_11a_2_environment_wiring_evidence"
    },
    "repository_full_name": {
      "type": "string",
      "const": "Halildeu/ao-kernel"
    },
    "environment_name": {
      "type": "string",
      "const": "ao-ma-plan-approval"
    },
    "environment_id": {
      "type": "integer",
      "minimum": 1
    },
    "environment_api_url": {
      "type": "string",
      "format": "uri"
    },
    "environment_html_url": {
      "type": "string",
      "format": "uri"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "observation_source": {
      "type": "string",
      "const": "github_environment_api"
    },
    "environment_exists": {
      "type": "boolean",
      "const": true
    },
    "required_reviewers_count": {
      "type": "integer",
      "minimum": 1
    },
    "required_reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "login", "id"],
        "properties": {
          "type": {
            "type": "string",
            "const": "User"
          },
          "login": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "prevent_self_review": {
      "type": "boolean",
      "const": true
    },
    "can_admins_bypass": {
      "type": "boolean",
      "const": false
    },
    "workflow_path": {
      "type": "string",
      "const": ".github/workflows/ao-ma-11a-plan-approval.yml"
    },
    "workflow_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_doc_path": {
      "type": "string",
      "const": ".claude/plans/AO-MA-11A-2-PLAN-APPROVAL-GATE.md"
    },
    "plan_doc_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gate_cli_path": {
      "type": "string",
      "const": "scripts/ao_ma11a2_plan_approval_gate.py"
    },
    "gate_cli_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gate_report_schema_path": {
      "type": "string",
      "const": "ao_kernel/defaults/schemas/ao-ma-11a-2-plan-approval-gate-report.schema.v1.json"
    },
    "gate_report_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "release_authority": {
      "type": "string",
      "const": "ao-release-gate+github-ruleset"
    },
    "ai_output_release_authority": {
      "type": "boolean",
      "const": false
    },
    "secrets_recorded": {
      "type": "boolean",
      "const": false
    },
    "support_widening": {
      "type": "boolean",
      "const": false
    },
    "production_platform_claim": {
      "type": "boolean",
      "const": false
    },
    "live_adapter_execution": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
