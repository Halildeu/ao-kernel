{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:ao-ma-changelog-discipline:v1",
  "title": "AO-MA Changelog Discipline Verdict",
  "description": "Schema for the verdict artifact produced by check_changelog_compliance (AO-MA-11G-1). Either CHANGELOG.md's [Unreleased] section gained a new bullet line in the PR diff, OR the PR carries an explicit 'chore-no-changelog' opt-out with a non-empty rationale. Anything else fails closed. Guard / authority fields stay const false: this is an evidence record, not an enforcement authority — CI enforcement wiring is AO-MA-11G-2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "checks",
    "evaluated_at",
    "guard_flags",
    "register_authority",
    "github_write_authorized"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ao-ma-changelog-discipline.v1"
    },
    "decision": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "evaluated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changelog_in_diff",
        "unreleased_entry_added",
        "chore_opt_out_satisfied"
      ],
      "properties": {
        "changelog_in_diff": { "$ref": "#/$defs/check_outcome" },
        "unreleased_entry_added": { "$ref": "#/$defs/check_outcome" },
        "chore_opt_out_satisfied": { "$ref": "#/$defs/check_outcome" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "guard_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_widening", "production_platform_claim", "live_adapter_execution"],
      "properties": {
        "support_widening": { "type": "boolean", "const": false },
        "production_platform_claim": { "type": "boolean", "const": false },
        "live_adapter_execution": { "type": "boolean", "const": false }
      }
    },
    "register_authority": {
      "type": "string",
      "const": "evidence_record_only"
    },
    "github_write_authorized": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "check_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "message": { "type": "string", "maxLength": 2048 }
      }
    }
  }
}
