{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ao-kernel.dev/schemas/ao-ma-github-mirror-sync-report.v1.json",
  "title": "AO-MA-11E-2b GitHub Mirror Sync Report",
  "description": "Dry-run or apply sync report from comparing manifest authority with actual GitHub mirror state and producing/applying issue body + label + project item sync diff. Generated by ao_kernel._internal.ao_ma.github_mirror_sync.sync_v5_mirror().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_manifest",
    "manifest_sha256",
    "checked_at",
    "network_allowed",
    "token_env",
    "token_present",
    "github_owner",
    "github_repo",
    "apply_mode",
    "confirmation_provided",
    "accepted_dry_run_report_digest",
    "planned_changes",
    "applied_changes",
    "pre_drift_snapshot",
    "post_drift_snapshot",
    "environment_preflight",
    "sync_state",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ao-ma-github-mirror-sync-report.v1"
    },
    "projection_manifest": { "type": "string", "minLength": 1 },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checked_at": { "type": "string", "format": "date-time" },
    "network_allowed": { "type": "boolean" },
    "token_env": { "type": "string", "minLength": 1 },
    "token_present": { "type": "boolean" },
    "github_owner": { "type": "string", "minLength": 1 },
    "github_repo": { "type": "string", "minLength": 1 },
    "apply_mode": {
      "type": "boolean",
      "description": "False = dry-run; True = apply (live GitHub write)."
    },
    "confirmation_provided": {
      "type": ["string", "null"],
      "description": "Operator-typed confirmation string. Must equal 'AO-MA-11E-2B-APPLY' for apply mode."
    },
    "accepted_dry_run_report_digest": {
      "type": ["string", "null"],
      "description": "SHA256 of the dry-run report the operator accepted (binds apply to a specific reviewed plan).",
      "pattern": "^(sha256:[0-9a-f]{64})?$"
    },
    "planned_changes": {
      "type": "array",
      "description": "Diff between manifest authority and actual GitHub state; populated in both dry-run and apply.",
      "items": { "$ref": "#/$defs/changeRecord" }
    },
    "applied_changes": {
      "type": "array",
      "description": "Subset of planned_changes actually applied (apply mode only); empty in dry-run.",
      "items": { "$ref": "#/$defs/changeRecord" }
    },
    "pre_drift_snapshot": {
      "type": ["object", "null"],
      "description": "11E-2a drift report at sync start; required for apply mode."
    },
    "post_drift_snapshot": {
      "type": ["object", "null"],
      "description": "11E-2a drift report after apply; required for apply mode."
    },
    "environment_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_name", "environment_exists", "required_reviewers_count", "environment_preflight_decision"],
      "properties": {
        "environment_name": { "type": "string" },
        "environment_exists": { "type": "boolean" },
        "required_reviewers_count": { "type": "integer", "minimum": 0 },
        "environment_preflight_decision": {
          "type": "string",
          "enum": ["pass", "fail_closed_missing", "fail_closed_no_reviewers", "skipped_dry_run"]
        }
      }
    },
    "sync_state": {
      "type": "string",
      "enum": [
        "not_started",
        "dry_run_planned",
        "dry_run_complete",
        "apply_in_progress",
        "applied",
        "applied_with_post_drift",
        "apply_aborted",
        "api_error",
        "usage_error"
      ]
    },
    "reason": {
      "type": ["string", "null"],
      "description": "Set for terminal states like apply_aborted, api_error, usage_error."
    }
  },
  "$defs": {
    "changeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "object_type", "object_id", "before", "after"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "issue_body_rewrite",
            "label_add",
            "label_remove",
            "project_item_add",
            "project_item_remove"
          ]
        },
        "object_type": {
          "type": "string",
          "enum": ["issue", "label", "project_item"]
        },
        "object_id": { "type": "string" },
        "before": {},
        "after": {}
      }
    }
  },
  "allOf": [
    {
      "description": "Dry-run mode: applied_changes MUST be empty.",
      "if": { "properties": { "apply_mode": { "const": false } } },
      "then": { "properties": { "applied_changes": { "maxItems": 0 } } }
    },
    {
      "description": "Apply mode + sync_state=applied: confirmation MUST equal apply token + accepted digest MUST be set + applied_changes non-empty.",
      "if": {
        "properties": {
          "apply_mode": { "const": true },
          "sync_state": { "const": "applied" }
        }
      },
      "then": {
        "properties": {
          "confirmation_provided": { "const": "AO-MA-11E-2B-APPLY" },
          "accepted_dry_run_report_digest": { "pattern": "^sha256:[0-9a-f]{64}$" },
          "applied_changes": { "minItems": 1 }
        }
      }
    },
    {
      "description": "Dry-run sync_state MUST be dry_run_planned or dry_run_complete.",
      "if": { "properties": { "apply_mode": { "const": false } } },
      "then": {
        "properties": {
          "sync_state": { "enum": ["dry_run_planned", "dry_run_complete", "api_error", "usage_error"] }
        }
      }
    }
  ]
}
