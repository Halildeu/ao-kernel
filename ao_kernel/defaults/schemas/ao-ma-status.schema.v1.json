{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:ao-ma-status:v1",
  "title": "AO-MA Status (derived machine-readable tracking SSOT)",
  "description": "Machine-readable tracking index for the AO-MA-SPM program. This artifact is a DERIVED tracking SSOT, NOT a governance authority: it does not and cannot override the master plan, plan-consensus bundles, plan approvals, the computed risk class, or the release authority (ao-release-gate + GitHub ruleset). It mirrors program state for operator visibility and for scripts/ao_ma_next.py. GitHub Issues/Milestones/Projects are a one-way mirror of this file (AO-MA-11E-2); manual GitHub edits never override it. Per-slice consensus/approval/evidence references are explicit state machines: a missing field is a schema error, never a silent 'not_started'. Guard flags are pinned const false; changing them requires a separate operator-bound supersession PR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status_role",
    "authority_model",
    "program_id",
    "program_title",
    "authority_ref",
    "repository_full_name",
    "master_plan_ref",
    "human_status_file",
    "current_phase",
    "current_slice",
    "phases",
    "slices",
    "blocked_slices",
    "required_startup_checks",
    "required_workflow",
    "forbidden_actions",
    "next_allowed_actions",
    "support_widening_allowed",
    "production_platform_claim_allowed",
    "live_adapter_execution_allowed",
    "release_authority",
    "ai_output_release_authority",
    "github_mirror",
    "drift_policy",
    "progress_estimates",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "ao-ma-status.v1" },
    "artifact_kind": { "type": "string", "const": "ao_ma_status" },
    "status_role": {
      "type": "string",
      "const": "machine_readable_derived_tracking_index",
      "description": "Pins that this file is a derived tracking index, not an authority."
    },
    "authority_model": {
      "type": "string",
      "const": "derived_from_master_plan_and_merged_ao_ma_artifacts",
      "description": "State is derived from the human master plan + merged AO-MA artifacts; it never originates authority."
    },
    "program_id": { "type": "string", "const": "ao-ma-spm" },
    "program_title": { "type": "string", "minLength": 1 },
    "authority_ref": { "type": "string", "const": "origin/main" },
    "repository_full_name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "master_plan_ref": { "$ref": "#/$defs/master_plan_ref" },
    "human_status_file": { "type": "string", "minLength": 1 },
    "current_phase": { "type": "string", "pattern": "^AO-MA-[A-Z0-9][A-Z0-9.]*$" },
    "current_slice": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/phase" }
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slice" }
    },
    "blocked_slices": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocked_slice" }
    },
    "required_startup_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/startup_check" }
    },
    "required_workflow": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_allowed_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "support_widening_allowed": { "type": "boolean", "const": false },
    "production_platform_claim_allowed": { "type": "boolean", "const": false },
    "live_adapter_execution_allowed": { "type": "boolean", "const": false },
    "release_authority": { "type": "string", "const": "ao-release-gate+github-ruleset" },
    "ai_output_release_authority": { "type": "boolean", "const": false },
    "github_mirror": { "$ref": "#/$defs/github_mirror" },
    "drift_policy": { "$ref": "#/$defs/drift_policy" },
    "progress_estimates": { "$ref": "#/$defs/progress_estimates" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "phase_status": {
      "type": "string",
      "enum": ["pending", "in_progress", "done"],
      "description": "Phase lifecycle. 'done' requires every owned slice to be merged + closed-out."
    },
    "slice_status": {
      "type": "string",
      "enum": ["not_started", "in_progress", "in_review", "merged", "blocked"],
      "description": "Slice lifecycle. 'merged' is the terminal success state for this tracking index."
    },
    "master_plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "commit_sha"],
      "properties": {
        "path": { "type": "string", "const": ".claude/plans/AO-MA-SPM-MASTER-PLAN.md" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "commit_sha": { "$ref": "#/$defs/commit_sha" },
        "section_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ao_authority_artifact",
        "artifact_sha256",
        "plan_digest",
        "phase_id",
        "slice_id",
        "last_sync_run_id",
        "mirror_projection_sha256"
      ],
      "properties": {
        "ao_authority_artifact": {
          "description": "Path of the merged authority artifact this row is derived from, or null before one exists.",
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "artifact_sha256": {
          "description": "SHA-256 of ao_authority_artifact bytes, or null before one exists.",
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "plan_digest": {
          "description": "plan_digest of the bound consensus bundle, or null before one exists.",
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "phase_id": { "type": "string", "pattern": "^AO-MA-[A-Z0-9][A-Z0-9.]*$" },
        "slice_id": { "type": "string", "minLength": 1 },
        "last_sync_run_id": {
          "description": "GitHub Actions run id of the last AO-MA-11E-2 mirror sync; null in 11E-1 (no GitHub write yet).",
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "mirror_projection_sha256": {
          "description": "SHA-256 of the projected GitHub mirror payload for this row; null until 11E-2 computes it.",
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "consensus_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "description": "Explicit state machine. 'state' is required; a missing object is a schema error (no silent not_started). When state=agreed the schema REQUIRES evidence (if/then): either a schema-bound on-disk consensus bundle (consensus_id + artifact_path + artifact_sha256 + plan_digest) OR a consultation_refs list that COVERS the full 3-AI quorum (one ref each for anthropic + openai + minimax). A bare or single-provider 'agreed' is rejected (no self-attestation, no single-provider consensus claim).",
      "properties": {
        "state": { "type": "string", "enum": ["not_started", "agreed", "not_agreed"] },
        "consensus_id": { "type": "string", "pattern": "^ao-ma-plan-[0-9]{8}-[a-z0-9]{6}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "plan_digest": { "$ref": "#/$defs/sha256" },
        "consultation_refs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "description": "Typed references to the 3-AI consultation threads/sessions that produced the AGREE. Must cover the full quorum: at least one ref for each of anthropic, openai, minimax (enforced by contains below).",
          "items": { "$ref": "#/$defs/consultation_ref" },
          "allOf": [
            { "contains": { "properties": { "provider_id": { "const": "anthropic" } }, "required": ["provider_id"] } },
            { "contains": { "properties": { "provider_id": { "const": "openai" } }, "required": ["provider_id"] } },
            { "contains": { "properties": { "provider_id": { "const": "minimax" } }, "required": ["provider_id"] } }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["state"], "properties": { "state": { "const": "agreed" } } },
          "then": {
            "anyOf": [
              { "required": ["consensus_id", "artifact_path", "artifact_sha256", "plan_digest"] },
              { "required": ["consultation_refs"] }
            ]
          }
        }
      ]
    },
    "approval_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "description": "Explicit state machine. 'state' is required; a missing object is a schema error. When state is approved/rejected/expired the schema REQUIRES evidence (if/then): either a schema-bound approval artifact (approval_id + artifact_path + artifact_sha256 + decision) OR an operator_decision_ref naming where the decision was recorded (e.g. the single-gate operator approval, a GitHub Environment audit URL, or a PR review). A decided state without either is rejected.",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not_requested", "pending", "approved", "rejected", "expired"]
        },
        "approval_id": { "type": "string", "pattern": "^ao-ma-approval-[0-9]{8}-[a-z0-9]{6}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "decision": { "type": "string", "enum": ["approved", "rejected", "expired"] },
        "operator_decision_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Where the operator decision was recorded when no schema-bound approval artifact exists yet (e.g. 'operator single-gate program approval 2026-05-30', a GitHub Environment audit URL, or a PR review URL)."
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "enum": ["approved", "rejected", "expired"] } }
          },
          "then": {
            "anyOf": [
              { "required": ["approval_id", "artifact_path", "artifact_sha256", "decision"] },
              { "required": ["operator_decision_ref"] }
            ]
          }
        }
      ]
    },
    "consultation_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "ref"],
      "properties": {
        "provider_id": { "type": "string", "enum": ["anthropic", "openai", "minimax"] },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Thread/session id for the consultation (e.g. a Codex thread id or a Mavis session id)."
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "required_for_closeout"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "required_for_closeout": { "type": "boolean" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "title", "status", "slice_ids"],
      "properties": {
        "phase_id": { "type": "string", "pattern": "^AO-MA-[A-Z0-9][A-Z0-9.]*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/phase_status" },
        "milestone_ref": {
          "description": "GitHub milestone number once mirrored (AO-MA-11E-2); null in 11E-1.",
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "slice_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "closed_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_id",
        "phase_id",
        "title",
        "status",
        "risk_class",
        "anchor",
        "consensus_ref",
        "approval_ref",
        "evidence_refs"
      ],
      "properties": {
        "slice_id": { "type": "string", "minLength": 1 },
        "phase_id": { "type": "string", "pattern": "^AO-MA-[A-Z0-9][A-Z0-9.]*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/slice_status" },
        "risk_class": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"],
          "description": "Recorded from the RiskClassifier / ao-release-gate changed-path classifier on real changed paths. This field is a RECORD, never an authority: it cannot downgrade the computed risk. high/critical requires high-risk lane / cross-provider supersession at merge time."
        },
        "issue_ref": {
          "description": "GitHub issue number once mirrored (AO-MA-11E-2); null in 11E-1.",
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "pr_refs": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "anchor": { "$ref": "#/$defs/anchor" },
        "consensus_ref": { "$ref": "#/$defs/consensus_ref" },
        "approval_ref": { "$ref": "#/$defs/approval_ref" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    },
    "blocked_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_id", "reason"],
      "properties": {
        "slice_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "startup_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "github_mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "direction", "manual_edit_override_allowed", "sync_state"],
      "properties": {
        "authority": { "type": "boolean", "const": false },
        "direction": { "type": "string", "const": "ao-kernel-to-github" },
        "manual_edit_override_allowed": { "type": "boolean", "const": false },
        "sync_state": {
          "type": "string",
          "enum": ["not_wired", "synced", "mirror_drift_detected"],
          "description": "11E-1 is always 'not_wired' (no GitHub write). 11E-2 sets 'synced' or 'mirror_drift_detected'."
        }
      }
    },
    "drift_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_status_or_mirror_drift", "comparator"],
      "properties": {
        "on_status_or_mirror_drift": { "type": "string", "const": "halt_autonomy_and_escalate" },
        "comparator": { "type": "string", "const": "pure_local_digest_and_inventory" }
      }
    },
    "progress_estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases", "slices"],
      "properties": {
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["done_count", "total_count", "percent", "next_phase_id"],
          "properties": {
            "done_count": { "type": "integer", "minimum": 0 },
            "total_count": { "type": "integer", "minimum": 1 },
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "next_phase_id": {
              "oneOf": [{ "type": "string", "pattern": "^AO-MA-[A-Z0-9][A-Z0-9.]*$" }, { "type": "null" }]
            }
          }
        },
        "slices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["merged_count", "total_count", "percent"],
          "properties": {
            "merged_count": { "type": "integer", "minimum": 0 },
            "total_count": { "type": "integer", "minimum": 1 },
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    }
  }
}
