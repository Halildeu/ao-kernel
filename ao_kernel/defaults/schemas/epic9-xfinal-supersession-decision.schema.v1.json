        "unevaluatedProperties": false,
        "required": ["path", "reinterpretation"],
        "properties": {
          "path": {"type": "string", "minLength": 8},
          "reinterpretation": {"type": "string", "minLength": 12}
        }
      }
    },
    "release_implication": {
      "type": "string",
      "const": "release_only_as_governed_control_plane_no_production_platform_claim_v4x_minor_preferred_v5_major_only_if_explicitly_renamed_governed_control_plane_ga_with_three_flags_false_in_changelog"
