      "allOf": [
        {"contains": {"properties": {"artifact": {"const": "tests/fixtures/epic9/xfinal-readiness-blocker.current.json"}}, "required": ["artifact"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"artifact": {"const": ".claude/plans/EPIC-9-FINAL-SUPERSESSION-PR.md"}}, "required": ["artifact"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"artifact": {"const": ".claude/plans/EPIC-9-PR-Xfinal-PRE-SUPERSESSION-CHECKLIST.md"}}, "required": ["artifact"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"artifact": {"const": ".claude/plans/V5-FULL-PRODUCTION-PROMOTION-ROADMAP.md"}}, "required": ["artifact"]}, "minContains": 1, "maxContains": 1}
