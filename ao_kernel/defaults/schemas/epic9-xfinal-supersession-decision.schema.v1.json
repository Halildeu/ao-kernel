            "init_and_doctor",
            "fail_closed_policy_check",
            "governed_context_persistence",
            "no_api_key_required"
          ],
          "properties": {
            "fresh_venv_pip_install": {"type": "boolean", "const": true},
            "init_and_doctor": {"type": "boolean", "const": true},
            "fail_closed_policy_check": {"type": "boolean", "const": true},
            "governed_context_persistence": {"type": "boolean", "const": true},
            "no_api_key_required": {"type": "boolean", "const": true}
          }
        },
        "pypi_baseline_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "evidence_class": {"type": "string", "const": "operator_local_consumer_smoke_not_project_owned_production_evidence"}
      }
    },
    "impact_on_existing_artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
