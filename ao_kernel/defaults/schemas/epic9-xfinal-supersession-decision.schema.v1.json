{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:epic9-xfinal-supersession-decision:v1",
  "title": "Epic 9 PR-Xfinal Supersession Decision",
  "description": "Records that the Epic 9 PR-Xfinal all-or-none V5 production-promotion path (atomic flip of live_adapter_execution + support_widening + production_platform_claim plus v5.0.0 production-platform claim) is SUPERSEDED — not failed, not deferred — by an explicit operator decision to keep ao-kernel a CLI-only / operator-mediated governed control-plane. This is a conscious product-boundary change, not an engineering escape. The three guard flags remain const false, which is the correct final state for this decision and consistent with RI-7.8c (operator non-promotion, cli-only) and GPP-9 (keep_narrow_stable_runtime). The pre-existing xfinal-readiness-blocker and EPIC-9-PR-Xfinal pre-supersession checklist are not deleted; they are reinterpreted as superseded / not applicable under this decision. AI output is evidence only; release authority remains the repo-owned ao-release-gate required check plus GitHub branch protection.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "repo",
    "work_package",
    "decision",
    "decision_effect",
    "scope",
    "operator_intent",
    "source_authority",
    "guard_flags_final_state",
    "support_widening",
    "production_platform_claim",
    "live_adapter_execution",
    "supersedes",
    "not_satisfied_requirements",
    "allowed_claims",
    "forbidden_claims",
    "evidence",
    "impact_on_existing_artifacts",
    "release_implication",
    "non_authority_boundary",
    "cross_ai_review_ref"
  ],
  "properties": {
