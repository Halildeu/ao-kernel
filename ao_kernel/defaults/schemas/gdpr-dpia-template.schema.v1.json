{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halildeu.github.io/ao-kernel/schemas/gdpr-dpia-template.schema.v1.json",
  "title": "ao-kernel GDPR DPIA Operator Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "framework_version",
    "guard_flags",
    "dpia_disclaimer",
    "personal_data_disclosure",
    "prohibited_claims",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": "gdpr-dpia-template.v1"},
    "artifact_kind": {"const": "gdpr-dpia-operator-template"},
    "framework_version": {"const": "GDPR-2018-applied"},
    "guard_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_widening_allowed",
        "production_platform_claim_allowed",
        "live_adapter_execution_allowed",
        "regulatory_filing_claim_allowed",
        "legal_advice_claim_allowed",
        "contract_template_allowed"
      ],
      "properties": {
        "support_widening_allowed": {"const": false},
        "production_platform_claim_allowed": {"const": false},
        "live_adapter_execution_allowed": {"const": false},
        "regulatory_filing_claim_allowed": {"const": false},
        "legal_advice_claim_allowed": {"const": false},
        "contract_template_allowed": {"const": false}
      }
    },
    "dpia_disclaimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_gdpr_certification",
        "not_regulatory_approval",
        "not_actual_dpia_filing",
        "not_legal_advice",
        "documentation_only",
        "operator_legal_counsel_required"
      ],
      "properties": {
        "not_gdpr_certification": {"const": true},
        "not_regulatory_approval": {"const": true},
        "not_actual_dpia_filing": {"const": true},
        "not_legal_advice": {"const": true},
        "documentation_only": {"const": true},
        "operator_legal_counsel_required": {"const": true}
      }
    },
    "personal_data_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ao_kernel_processes_personal_data",
        "no_personal_data_in_repo",
        "not_data_controller",
        "not_data_processor_in_v1",
        "operator_dpia_decision"
      ],
      "properties": {
        "ao_kernel_processes_personal_data": {"const": false},
        "no_personal_data_in_repo": {"const": true},
        "not_data_controller": {"const": true},
        "not_data_processor_in_v1": {"const": true},
        "operator_dpia_decision": {"const": true}
      }
    },
    "prohibited_claims": {
      "type": "array",
      "minItems": 22,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "sections": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"$ref": "#/$defs/section_0_metadata"},
        {"$ref": "#/$defs/section_a_systematic_description"},
        {"$ref": "#/$defs/section_b_necessity_proportionality"},
        {"$ref": "#/$defs/section_c_risks"},
        {"$ref": "#/$defs/section_d_mitigation"},
        {"$ref": "#/$defs/section_e_consultation"},
        {"$ref": "#/$defs/section_f_decision_approval"}
      ]
    }
  },
  "$defs": {
    "section_0_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields", "dpia_trigger_assessment"],
      "properties": {
        "id": {"const": "section_0_metadata"},
        "title": {"type": "string", "minLength": 3},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controller_name",
            "dpo_contact",
            "dpa_reference",
            "version",
            "supervisory_authority"
          ],
          "properties": {
            "controller_name": {"type": "string"},
            "dpo_contact": {"type": "string"},
            "dpa_reference": {"type": "string"},
            "version": {"type": "string"},
            "supervisory_authority": {"type": "string"}
          }
        },
        "dpia_trigger_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo_baseline_triggered",
            "operator_must_assess_art35_3",
            "operator_must_check_supervisory_authority_lists",
            "special_categories_or_art10_data_in_repo",
            "art35_3_a_systematic_profiling_in_repo",
            "art35_3_b_large_scale_special_categories_in_repo",
            "art35_3_c_systematic_monitoring_public_area_in_repo",
            "art36_residual_high_risk_prior_consultation_reminder"
          ],
          "properties": {
            "repo_baseline_triggered": {"const": false},
            "operator_must_assess_art35_3": {"const": true},
            "operator_must_check_supervisory_authority_lists": {"const": true},
            "special_categories_or_art10_data_in_repo": {"const": false},
            "art35_3_a_systematic_profiling_in_repo": {"const": false},
            "art35_3_b_large_scale_special_categories_in_repo": {"const": false},
            "art35_3_c_systematic_monitoring_public_area_in_repo": {"const": false},
            "art36_residual_high_risk_prior_consultation_reminder": {"type": "string", "minLength": 20}
          }
        }
      }
    },
    "section_a_systematic_description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"const": "section_a_systematic_description"},
        "title": {"type": "string", "minLength": 3},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "processing_operations",
            "purposes",
            "data_subjects",
            "personal_data_categories",
            "recipients",
            "transfers",
            "retention",
            "systems",
            "processors_subprocessors",
            "data_flow_summary"
          ],
          "properties": {
            "processing_operations": {"type": "string"},
            "purposes": {"type": "string"},
            "data_subjects": {"type": "string"},
            "personal_data_categories": {"type": "string"},
            "recipients": {"type": "string"},
            "transfers": {"type": "string"},
            "retention": {"type": "string"},
            "systems": {"type": "string"},
            "processors_subprocessors": {"type": "string"},
            "data_flow_summary": {"type": "string"}
          }
        }
      }
    },
    "section_b_necessity_proportionality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"const": "section_b_necessity_proportionality"},
        "title": {"type": "string", "minLength": 3},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "necessity_assessment",
            "proportionality_assessment",
            "data_minimization_statement",
            "lawful_basis_consideration_operator_owned"
          ],
          "properties": {
            "necessity_assessment": {"type": "string"},
            "proportionality_assessment": {"type": "string"},
            "data_minimization_statement": {"type": "string"},
            "lawful_basis_consideration_operator_owned": {"type": "string"}
          }
        }
      }
    },
    "section_c_risks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "risks"],
      "properties": {
        "id": {"const": "section_c_risks"},
        "title": {"type": "string", "minLength": 3},
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/risk_item"}
        }
      }
    },
    "risk_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "risk_name", "risk_status", "likelihood", "severity", "risk_score", "mitigation"],
      "properties": {
        "risk_id": {"type": "string", "minLength": 2},
        "risk_name": {"type": "string", "minLength": 3},
        "risk_status": {
          "enum": [
            "not_applicable",
            "identified",
            "mitigated",
            "residual_high_risk_requires_art36_review"
          ]
        },
        "likelihood": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "risk_score": {"type": ["string", "null"]},
        "mitigation": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"risk_status": {"const": "not_applicable"}}, "required": ["risk_status"]},
          "then": {
            "properties": {
              "likelihood": {"const": null},
              "severity": {"const": null},
              "risk_score": {"const": null},
              "mitigation": {"const": null}
            }
          }
        },
        {
          "if": {
            "properties": {"risk_status": {"enum": ["identified", "mitigated", "residual_high_risk_requires_art36_review"]}},
            "required": ["risk_status"]
          },
          "then": {
            "properties": {
              "likelihood": {"type": "string", "minLength": 1},
              "severity": {"type": "string", "minLength": 1},
              "risk_score": {"type": "string", "minLength": 1},
              "mitigation": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "section_d_mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"const": "section_d_mitigation"},
        "title": {"type": "string", "minLength": 3},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "technical_measures",
            "organizational_measures",
            "residual_risk_summary",
            "operator_owned_measures"
          ],
          "properties": {
            "technical_measures": {"type": "string"},
            "organizational_measures": {"type": "string"},
            "residual_risk_summary": {"type": "string"},
            "operator_owned_measures": {"type": "string"}
          }
        }
      }
    },
    "section_e_consultation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"const": "section_e_consultation"},
        "title": {"type": "string", "minLength": 3},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dpo_advice_status",
            "data_subject_views_status",
            "supervisory_authority_prior_consultation_status",
            "consultation_evidence_reference"
          ],
          "properties": {
            "dpo_advice_status": {
              "enum": [
                "not_applicable_repo_baseline",
                "operator_to_determine",
                "completed_operator_reference",
                "not_required_operator_assessment"
              ]
            },
            "data_subject_views_status": {
              "enum": [
                "not_applicable_repo_baseline",
                "operator_to_determine",
                "completed_operator_reference",
                "not_required_operator_assessment"
              ]
            },
            "supervisory_authority_prior_consultation_status": {
              "enum": [
                "not_applicable_repo_baseline",
                "operator_to_determine",
                "completed_operator_reference",
                "not_required_operator_assessment"
              ]
            },
            "consultation_evidence_reference": {"type": "string"}
          }
        }
      }
    },
    "section_f_decision_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fields"],
      "properties": {
        "id": {"const": "section_f_decision_approval"},
        "title": {"type": "string", "minLength": 3},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator_decision_record",
            "operator_decision_date",
            "operator_approver_role",
            "operator_review_cadence"
          ],
          "properties": {
            "operator_decision_record": {"type": "string"},
            "operator_decision_date": {"type": "string"},
            "operator_approver_role": {"type": "string"},
            "operator_review_cadence": {"type": "string"}
          }
        }
      }
    }
  }
}
