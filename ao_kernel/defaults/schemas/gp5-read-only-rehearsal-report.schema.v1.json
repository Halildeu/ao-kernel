{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:gp5-read-only-rehearsal-report:v1",
  "title": "GP-5 read-only workflow rehearsal report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "overall_status",
    "decision",
    "support_widening",
    "repo_intelligence_handoff",
    "repo_intelligence_opt_in_validation",
    "workflow_rehearsal"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_kind": { "const": "gp5_read_only_workflow_rehearsal_report" },
    "overall_status": { "enum": ["pass", "blocked"] },
    "decision": {
      "enum": [
        "pass_read_only_rehearsal_no_support_widening",
        "blocked_read_only_rehearsal_no_support_widening"
      ]
    },
    "support_widening": { "const": false },
    "repo_intelligence_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source",
        "repo_query_command_contract",
        "generation_steps",
        "markdown_sha256",
        "markdown_bytes",
        "hidden_injection",
        "mcp_tool_used",
        "root_export_used",
        "context_compiler_auto_feed"
      ],
      "properties": {
        "mode": { "const": "explicit_operator_markdown" },
        "source": { "enum": ["deterministic_contract_fixture"] },
        "repo_query_command_contract": { "type": "string", "minLength": 1 },
        "generation_steps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "markdown_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "markdown_bytes": { "type": "integer", "minimum": 1 },
        "hidden_injection": { "const": false },
        "mcp_tool_used": { "const": false },
        "root_export_used": { "const": false },
        "context_compiler_auto_feed": { "const": false }
      }
    },
    "repo_intelligence_opt_in_validation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "status",
        "enabled",
        "decision",
        "support_widening",
        "production_platform_claim"
      ],
      "properties": {
        "status": { "enum": ["accepted", "blocked"] },
        "enabled": { "const": true },
        "decision": {
          "enum": [
            "accepted_repo_intelligence_workflow_opt_in",
            "blocked_repo_intelligence_workflow_opt_in"
          ]
        },
        "support_widening": { "const": false },
        "production_platform_claim": { "const": false },
        "handoff": {
          "type": "object",
          "additionalProperties": true,
          "required": ["markdown_sha256"],
          "properties": {
            "markdown_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "mode": { "enum": ["explicit_operator_markdown"] },
            "support_tier": { "enum": ["beta_explicit_handoff"] }
          }
        },
        "source_metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "vector_namespace_key_prefix": {
              "type": "string",
              "pattern": "^repo_chunk::[^:]+::[^:]+::$"
            },
            "freshness_state": { "enum": ["current_only"] },
            "stale_candidates": { "const": 0 },
            "retrieved_chunks": { "type": "integer", "minimum": 1 }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "hidden_injection": { "const": false },
            "root_export": { "const": false },
            "mcp_exposure": { "const": false },
            "context_compiler_auto_feed": { "const": false },
            "vector_writes": { "const": false },
            "artifact_writes": { "const": false }
          }
        },
        "findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workflow_rehearsal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "adapter_id",
        "execution_mode",
        "command",
        "returncode",
        "final_state",
        "remote_side_effects",
        "write_side_workflow_support_implied",
        "real_adapter_called",
        "review_findings_artifact_path",
        "evidence_timeline_path",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "workflow_id": { "const": "review_ai_flow" },
        "adapter_id": { "const": "codex-stub" },
        "execution_mode": { "const": "wheel_installed_temp_venv" },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "returncode": { "type": "integer" },
        "final_state": { "type": ["string", "null"] },
        "remote_side_effects": { "const": false },
        "write_side_workflow_support_implied": { "const": false },
        "real_adapter_called": { "const": false },
        "review_findings_artifact_path": { "type": ["string", "null"] },
        "evidence_timeline_path": { "type": ["string", "null"] },
        "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "blocked_reason": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "overall_status": { "const": "blocked" } } },
      "then": { "required": ["blocked_reason"] }
    },
    {
      "if": { "properties": { "overall_status": { "const": "pass" } } },
      "then": {
        "properties": {
          "repo_intelligence_opt_in_validation": {
            "properties": {
              "status": { "const": "accepted" }
            }
          },
          "workflow_rehearsal": {
            "required": ["command"],
            "properties": {
              "command": { "minItems": 1 },
              "final_state": { "const": "completed" },
              "review_findings_artifact_path": { "type": "string", "minLength": 1 },
              "evidence_timeline_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
