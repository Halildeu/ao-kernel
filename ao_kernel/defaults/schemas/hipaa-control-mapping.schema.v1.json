{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:hipaa-control-mapping:v1",
  "title": "ao-kernel HIPAA Control Mapping (V5 Epic 6 E-6-3b)",
  "description": "Schema-backed HIPAA Safeguards + Privacy Rule + Breach Notification control-reference mapping. NOT a HIPAA compliance claim; NOT a BAA template; NO PHI processing. Codex 019e84ee cross-AI plan-time AGREE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "artifact_kind",
    "framework_version",
    "guard_flags",
    "hipaa_disclaimer",
    "phi_handling_disclosure",
    "prohibited_claims",
    "sections"
  ],
  "properties": {
    "schema_version": { "const": "hipaa-control-mapping.v1" },
    "service": { "const": "ao-kernel" },
    "artifact_kind": { "const": "hipaa-control-mapping" },
    "framework_version": { "const": "HIPAA-2003-amended-2013" },
    "guard_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_widening_allowed",
        "production_platform_claim_allowed",
        "live_adapter_execution_allowed"
      ],
      "properties": {
        "support_widening_allowed": { "const": false },
        "production_platform_claim_allowed": { "const": false },
        "live_adapter_execution_allowed": { "const": false }
      }
    },
    "hipaa_disclaimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_certified",
        "not_audited",
        "documentation_only",
        "not_phi_processor",
        "not_baa_template",
        "operator_legal_counsel_required"
      ],
      "properties": {
        "not_certified": { "const": true },
        "not_audited": { "const": true },
        "documentation_only": { "const": true },
        "not_phi_processor": { "const": true },
        "not_baa_template": { "const": true },
        "operator_legal_counsel_required": { "const": true }
      }
    },
    "phi_handling_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ao_kernel_processes_phi",
        "no_phi_in_repo",
        "operator_phi_handler_decision"
      ],
      "properties": {
        "ao_kernel_processes_phi": { "const": false },
        "no_phi_in_repo": { "const": true },
        "operator_phi_handler_decision": { "const": true }
      }
    },
    "prohibited_claims": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 4 }
    },
    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "section_status", "section_rationale", "controls"],
      "properties": {
        "id": {
          "enum": [
            "administrative_safeguards",
            "physical_safeguards",
            "technical_safeguards",
            "privacy_rule",
            "breach_notification"
          ]
        },
        "name": { "type": "string", "minLength": 8 },
        "section_status": { "enum": ["applicable", "not_applicable", "mixed"] },
        "section_rationale": { "type": "string", "minLength": 24 },
        "controls": {
          "type": "array",
          "items": { "$ref": "#/$defs/control" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "section_status": { "const": "not_applicable" } } },
          "then": {
            "properties": { "controls": { "maxItems": 0 } }
          }
        },
        {
          "if": {
            "properties": {
              "section_status": { "enum": ["applicable", "mixed"] }
            }
          },
          "then": {
            "properties": { "controls": { "minItems": 1 } }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "citation",
        "name",
        "ao_kernel_status",
        "status_rationale",
        "operator_boundary",
        "ephi_control_operator_owned",
        "hipaa_control_effectiveness_claim",
        "evidence_refs"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$",
          "minLength": 4,
          "maxLength": 64
        },
        "citation": {
          "type": "string",
          "pattern": "^§164\\.[0-9]{3}(\\([a-z]\\))?(\\([0-9]+\\))?([a-z])?(-([0-9]{3})?(-164\\.[0-9]{3})?)?$",
          "minLength": 6,
          "maxLength": 32
        },
        "name": { "type": "string", "minLength": 8 },
        "ao_kernel_status": {
          "enum": ["documented", "partial", "out_of_scope", "not_applicable"]
        },
        "status_rationale": { "type": "string", "minLength": 24 },
        "operator_boundary": { "type": "string", "minLength": 16 },
        "ephi_control_operator_owned": { "const": true },
        "hipaa_control_effectiveness_claim": { "const": false },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "description", "claim_boundary"],
      "properties": {
        "type": { "enum": ["pr", "adr", "hard_rule", "doc", "test", "source"] },
        "ref": { "type": "string", "minLength": 3 },
        "path": { "type": "string" },
        "description": { "type": "string", "minLength": 8 },
        "claim_boundary": { "type": "string", "minLength": 8 }
      }
    }
  }
}
