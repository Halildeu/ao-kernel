{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/live_adapter_envelope.schema.v1.json",
  "title": "Live Adapter Envelope (V5 Epic 2 E-2-1)",
  "description": "Governance envelope for a single (would-be) LLM provider call. Infrastructure-only: mode is stub|dry_run, live_adapter_execution is const false. The 'live' mode and any flag flip live in a separate v2 schema gated by the Epic 9 operator-bound supersession PR. No secret material is ever captured in this envelope.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "mode",
    "live_adapter_execution",
    "request",
    "response",
    "cost",
    "circuit_breaker",
    "secret_boundary",
    "timestamps"
  ],
  "properties": {
    "schema_version": { "const": "live-adapter-envelope.v1" },
    "artifact_kind": { "const": "live_adapter_envelope" },
    "mode": {
      "type": "string",
      "enum": ["stub", "dry_run"],
      "description": "'live' is intentionally absent: real network execution is gated by a separate v2 schema + Epic 9 supersession PR."
    },
    "live_adapter_execution": {
      "const": false,
      "description": "Guard flag pin (ADR-0002 recompute-not-trust). This schema never represents a live execution."
    },
    "support_widening": {
      "const": false,
      "description": "Optional guard-flag affirmation; if present it MUST be false."
    },
    "production_platform_claim": {
      "const": false,
      "description": "Optional guard-flag affirmation; if present it MUST be false."
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["provider_id", "model", "request_id", "intent", "messages_digest", "params"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "intent": { "type": "string", "minLength": 1 },
        "messages_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "unevaluatedProperties": false,
          "properties": {
            "temperature": { "type": "number", "minimum": 0 },
            "max_tokens": { "type": "integer", "minimum": 1 },
            "top_p": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["text_digest", "usage", "latency_ms", "status"],
      "properties": {
        "text_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "unevaluatedProperties": false,
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "latency_ms": { "type": "number", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["ok", "stub_emitted", "dry_run_emitted", "error"]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "currency",
        "input_cost_per_1k_usd",
        "output_cost_per_1k_usd",
        "actual_cost_usd",
        "pricing_source_digest"
      ],
      "properties": {
        "currency": { "type": "string", "enum": ["USD"] },
        "input_cost_per_1k_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{8}$" },
        "output_cost_per_1k_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{8}$" },
        "actual_cost_usd": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{8}$" },
        "pricing_source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["state", "failure_count", "last_failure_at"],
      "properties": {
        "state": { "type": "string", "enum": ["CLOSED", "OPEN", "HALF_OPEN"] },
        "failure_count": { "type": "integer", "minimum": 0 },
        "last_failure_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "secret_boundary": {
      "const": "no_secret_material_emitted_no_token_no_credential"
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["created_at", "finalized_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "finalized_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "stub" } } },
      "then": { "properties": { "response": { "properties": { "status": { "const": "stub_emitted" } } } } }
    },
    {
      "if": { "properties": { "mode": { "const": "dry_run" } } },
      "then": { "properties": { "response": { "properties": { "status": { "const": "dry_run_emitted" } } } } }
    },
    {
      "if": {
        "properties": { "circuit_breaker": { "properties": { "state": { "const": "CLOSED" } } } }
      },
      "then": {
        "properties": { "circuit_breaker": { "properties": { "failure_count": { "const": 0 } } } }
      }
    }
  ]
}
