{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halildeu.github.io/ao-kernel/schemas/pci-dss-control-mapping.schema.v1.json",
  "title": "ao-kernel PCI-DSS v4.0.1 Control Reference Mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "service",
    "operator_owned",
    "is_contractual_sla",
    "framework_version",
    "guard_flags",
    "pci_disclaimer",
    "chd_handling_disclosure",
    "saq_applicability",
    "prohibited_claims",
    "requirements"
  ],
  "properties": {
    "schema_version": {"const": "pci-dss-control-mapping.v1"},
    "artifact_kind": {"const": "pci-dss-control-reference-mapping"},
    "service": {"const": "ao-kernel"},
    "operator_owned": {"const": true},
    "is_contractual_sla": {"const": false},
    "framework_version": {"const": "PCI-DSS-v4.0.1"},
    "guard_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_widening_allowed",
        "production_platform_claim_allowed",
        "live_adapter_execution_allowed",
        "cde_claim_allowed",
        "qsa_assessment_claim_allowed",
        "saq_filing_claim_allowed"
      ],
      "properties": {
        "support_widening_allowed": {"const": false},
        "production_platform_claim_allowed": {"const": false},
        "live_adapter_execution_allowed": {"const": false},
        "cde_claim_allowed": {"const": false},
        "qsa_assessment_claim_allowed": {"const": false},
        "saq_filing_claim_allowed": {"const": false}
      }
    },
    "pci_disclaimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_pci_certified",
        "not_aoc_holder",
        "not_roc_holder",
        "not_saq_filed",
        "not_asv_scanned",
        "documentation_only",
        "operator_qsa_engagement_required"
      ],
      "properties": {
        "not_pci_certified": {"const": true},
        "not_aoc_holder": {"const": true},
        "not_roc_holder": {"const": true},
        "not_saq_filed": {"const": true},
        "not_asv_scanned": {"const": true},
        "documentation_only": {"const": true},
        "operator_qsa_engagement_required": {"const": true}
      }
    },
    "chd_handling_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ao_kernel_processes_chd",
        "ao_kernel_processes_sad",
        "no_pan_in_repo",
        "no_cde_in_repo",
        "operator_cde_decision"
      ],
      "properties": {
        "ao_kernel_processes_chd": {"const": false},
        "ao_kernel_processes_sad": {"const": false},
        "no_pan_in_repo": {"const": true},
        "no_cde_in_repo": {"const": true},
        "operator_cde_decision": {"const": true}
      }
    },
    "saq_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_baseline_saq", "operator_determines", "available_saq_types"],
      "properties": {
        "repo_baseline_saq": {"const": "none"},
        "operator_determines": {"const": true},
        "available_saq_types": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/saq_type"}
        }
      }
    },
    "prohibited_claims": {
      "type": "array",
      "minItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "requirements": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/requirement"},
      "allOf": [
        {"contains": {"properties": {"req_id": {"const": "1"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "2"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "3"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "4"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "5"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "6"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "7"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "8"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "9"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "10"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "11"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"req_id": {"const": "12"}}, "required": ["req_id"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "saq_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_slug", "display_label"],
      "properties": {
        "type_slug": {
          "enum": [
            "saq_a",
            "saq_a_ep",
            "saq_b",
            "saq_b_ip",
            "saq_c",
            "saq_c_vt",
            "saq_d_merchant",
            "saq_d_service_provider",
            "saq_p2pe"
          ]
        },
        "display_label": {"type": "string", "minLength": 3}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["req_id", "req_title", "req_status", "req_rationale", "operator_boundary", "evidence_refs"],
      "properties": {
        "req_id": {"type": "string", "pattern": "^(?:[1-9]|1[0-2])$"},
        "req_title": {"type": "string", "minLength": 3},
        "req_status": {"enum": ["documented", "partial", "out_of_scope", "not_applicable"]},
        "req_rationale": {"type": "string", "minLength": 10},
        "operator_boundary": {"type": "string", "minLength": 10},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_ref"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"req_status": {"enum": ["out_of_scope", "not_applicable"]}}, "required": ["req_status"]},
          "then": {"properties": {"evidence_refs": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"req_status": {"enum": ["documented", "partial"]}}, "required": ["req_status"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "description"],
      "properties": {
        "type": {"enum": ["pr", "doc", "test", "source", "hard_rule"]},
        "ref": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 3}
      }
    }
  }
}
