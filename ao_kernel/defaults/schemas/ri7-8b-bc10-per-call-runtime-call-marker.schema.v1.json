{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:ri7-8b-bc10-per-call-runtime-call-marker:v1",
  "title": "RI-7.8b-bc10 Per-Call Runtime Call Marker",
  "description": "Runtime artifact emitted by RI-7.8b-bc10 protected workflow for EACH scenario in the sequential bc10_run_scenarios.py loop. This is NOT final evidence — final per-call evidence, aggregate, and closure proof come from RI-7.8b-bc10-6c. Marker is redacted: NO provider response body, NO token material, NO API key. Schema enforces coherence between scenario, provider_call_performed, billable_call_count_delta, scenario_outcome, and cost fields. 4 markers per workflow run: 3 success_billable (small_completion_a/b/c) + 1 budget_cap_precheck_denied (no provider call, zero cost).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "scenario",
    "scenario_outcome",
    "requested_model",
    "resolved_model",
    "model_allowlist_enforced",
    "model_allowlist",
    "max_output_tokens_cap",
    "provider_call_performed",
    "billable_call_count_delta",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "projected_cost_usd",
    "actual_cost_usd",
    "cumulative_cost_usd_before",
    "cumulative_cost_usd_after",
    "pricing_source_digest",
    "usage_source",
    "cost_source",
    "run_id",
    "run_attempt",
    "head_sha",
    "workflow_ref",
    "workflow_content_sha256",
    "secret_boundary",
    "raw_response_recorded",
    "secret_material_recorded",
    "secret_scope_after_all_pre_provider_guards",
    "budget_cap_precheck_denied_completes_without_provider_client_init",
    "budget_cap_precheck_denied_completes_without_api_key_read",
    "retry_behavior"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "ri7-8b-bc10-per-call-runtime-call-marker.v1"},
    "artifact_kind": {"type": "string", "const": "ri7_8b_bc10_per_call_runtime_call_marker"},
    "scenario": {
      "type": "string",
      "enum": ["small_completion_a", "small_completion_b", "small_completion_c", "budget_cap_precheck_denied"]
    },
    "scenario_outcome": {
      "type": "string",
      "enum": ["success_billable", "budget_cap_precheck_denied", "unexpected_failure"]
    },
    "requested_model": {"type": "string", "enum": ["openai/gpt-4o-mini"]},
    "resolved_model": {"type": "string", "enum": ["openai/gpt-4o-mini"]},
    "model_allowlist_enforced": {"type": "boolean", "const": true},
    "model_allowlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["openai/gpt-4o-mini"]}
    },
    "max_output_tokens_cap": {"type": "integer", "minimum": 1, "maximum": 256},
    "provider_call_performed": {"type": "boolean"},
    "billable_call_count_delta": {"type": "integer", "minimum": 0, "maximum": 1},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "projected_cost_usd": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{8}$",
      "description": "Decimal string with 8 decimal places."
    },
    "actual_cost_usd": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{8}$"
    },
    "cumulative_cost_usd_before": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{8}$"
    },
    "cumulative_cost_usd_after": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{8}$"
    },
    "pricing_source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest of the pinned pricing source file. Must match the digest pinned in gpp_status.operator_bound_supersessions[RI-7.8b-bc10-6b].pricing_source.source_digest."
    },
    "usage_source": {
      "type": "string",
      "enum": ["provider_api_response", "no_call_no_usage"]
    },
    "cost_source": {
      "type": "string",
      "enum": ["provider_usage_plus_pinned_pricing_source", "no_billable_provider_call"]
    },
    "run_id": {"type": "string", "minLength": 1},
    "run_attempt": {"type": "string", "const": "1"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflow_ref": {"type": "string", "minLength": 1},
    "workflow_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "secret_boundary": {
      "type": "string",
      "const": "no_secret_material_emitted_no_token_no_credential"
    },
    "raw_response_recorded": {"type": "boolean", "const": false},
    "secret_material_recorded": {"type": "boolean", "const": false},
    "secret_scope_after_all_pre_provider_guards": {"type": "boolean", "const": true},
    "budget_cap_precheck_denied_completes_without_provider_client_init": {"type": "boolean", "const": true},
    "budget_cap_precheck_denied_completes_without_api_key_read": {"type": "boolean", "const": true},
    "retry_behavior": {
      "type": "string",
      "const": "wrapper_no_retry_loop_transport_default_skipped"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario": {"const": "budget_cap_precheck_denied"}
        },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "provider_call_performed": {"const": false},
          "billable_call_count_delta": {"const": 0},
          "scenario_outcome": {"const": "budget_cap_precheck_denied"},
          "input_tokens": {"const": 0},
          "output_tokens": {"const": 0},
          "total_tokens": {"const": 0},
          "actual_cost_usd": {"const": "0.00000000"},
          "usage_source": {"const": "no_call_no_usage"},
          "cost_source": {"const": "no_billable_provider_call"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_outcome": {"const": "success_billable"}
        },
        "required": ["scenario_outcome"]
      },
      "then": {
        "properties": {
          "provider_call_performed": {"const": true},
          "billable_call_count_delta": {"const": 1},
          "usage_source": {"const": "provider_api_response"},
          "cost_source": {"const": "provider_usage_plus_pinned_pricing_source"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_call_performed": {"const": false}
        },
        "required": ["provider_call_performed"]
      },
      "then": {
        "properties": {
          "actual_cost_usd": {"const": "0.00000000"},
          "usage_source": {"const": "no_call_no_usage"},
          "billable_call_count_delta": {"const": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "enum": ["small_completion_a", "small_completion_b", "small_completion_c"]
          }
        },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "scenario_outcome": {
            "enum": ["success_billable", "unexpected_failure"]
          }
        }
      }
    }
  ]
}
