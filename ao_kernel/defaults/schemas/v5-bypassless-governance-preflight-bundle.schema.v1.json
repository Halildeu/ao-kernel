{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ao:v5-bypassless-governance-preflight-bundle:v1",
  "title": "V5 bypassless release governance preflight evidence bundle v1",
  "description": "Current-state preflight bundle for the V5 bypassless release governance dimension (production readiness matrix dimension 9). It records the already-active repo merge-governance controls (source-pinned required checks, empty bypass actors, autonomous merge trail for low-risk changes, cross-provider review for guarded changes) while keeping final promotion and all production guard flags fail-closed. It is not promotion authority; the final ruleset source-pin and required-check uniqueness evidence remain bound to PR-Xfinal.",
  "type": "object",
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "repo",
    "work_package",
    "dimension",
    "evidence_class",
    "final_release_bound",
    "support_widening",
    "production_platform_claim",
    "live_adapter_execution",
    "current_boundary",
    "governance_documents",
    "governance_controls",
    "residual_missing_evidence",
    "issue_refs"
  ],
  "properties": {
    "schema_version": { "const": "v5_bypassless_governance_preflight_bundle.v1" },
    "artifact_kind": { "const": "v5_bypassless_governance_preflight_bundle" },
    "repo": { "const": "Halildeu/ao-kernel" },
    "work_package": { "const": "E-9-1" },
    "dimension": { "const": "bypassless_release_governance" },
    "evidence_class": { "const": "preflight_current_state" },
    "final_release_bound": { "const": false },
    "support_widening": { "const": false },
    "production_platform_claim": { "const": false },
    "live_adapter_execution": { "const": false },
    "current_boundary": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "required_check_authority",
        "required_checks",
        "bypass_actors_count",
        "admin_merge_used",
        "autonomous_merge_for_low_risk",
        "cross_provider_review_for_guarded_changes",
        "final_ruleset_source_pin_bound_to_pr_xfinal"
      ],
      "properties": {
        "required_check_authority": { "const": "github_branch_ruleset" },
        "required_checks": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": ["ao-release-gate-technical", "ao-release-gate-review"]
          }
        },
        "bypass_actors_count": { "const": 0 },
        "admin_merge_used": { "const": false },
        "autonomous_merge_for_low_risk": { "const": true },
        "cross_provider_review_for_guarded_changes": { "const": true },
        "final_ruleset_source_pin_bound_to_pr_xfinal": { "const": false }
      }
    },
    "governance_documents": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": [
        "repo_governance_path",
        "hardening_program_status_path",
        "gpp_status_path"
      ],
      "properties": {
        "repo_governance_path": { "const": ".github/REPO-GOVERNANCE.md" },
        "hardening_program_status_path": { "const": ".claude/plans/PRODUCTION-HARDENING-PROGRAM-STATUS.md" },
        "gpp_status_path": { "const": ".claude/plans/gpp_status.v1.json" }
      }
    },
    "governance_controls": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "unevaluatedProperties": false,
        "required": [
          "control",
          "current_state",
          "future_prerequisite_under_pr_xfinal"
        ],
        "properties": {
          "control": {
            "type": "string",
            "enum": [
              "ao_release_gate_required_check_source_pin",
              "empty_bypass_actors",
              "autonomous_merge_trail_low_risk",
              "cross_provider_review_guarded_changes"
            ]
          },
          "current_state": {
            "type": "string",
            "enum": ["active_in_current_repo_governance"]
          },
          "future_prerequisite_under_pr_xfinal": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": { "control": { "const": "ao_release_gate_required_check_source_pin" } },
            "required": ["control"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "control": { "const": "empty_bypass_actors" } },
            "required": ["control"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "control": { "const": "autonomous_merge_trail_low_risk" } },
            "required": ["control"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "control": { "const": "cross_provider_review_guarded_changes" } },
            "required": ["control"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "residual_missing_evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "allOf": [
        {
          "contains": { "type": "string", "pattern": "(?i)ruleset source-pin" },
          "minContains": 1
        },
        {
          "contains": { "type": "string", "pattern": "(?i)uniqueness" },
          "minContains": 1
        }
      ]
    },
    "issue_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^#[0-9]+$" }
    }
  }
}
