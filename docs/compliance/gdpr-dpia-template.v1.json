          "risk_status": "not_applicable",
          "likelihood": null,
          "severity": null,
          "risk_score": null,
          "mitigation": null
        },
        {
          "risk_id": "C2",
          "risk_name": "Loss or destruction of personal data",
          "risk_status": "not_applicable",
          "likelihood": null,
          "severity": null,
          "risk_score": null,
          "mitigation": null
        },
        {
          "risk_id": "C3",
          "risk_name": "Identification or re-identification of data subjects",
          "risk_status": "not_applicable",
          "likelihood": null,
          "severity": null,
          "risk_score": null,
          "mitigation": null
        },
        {
          "risk_id": "C4",
          "risk_name": "Profiling or automated decision-making impact",
          "risk_status": "not_applicable",
          "likelihood": null,
          "severity": null,
          "risk_score": null,
          "mitigation": null
        },
        {
          "risk_id": "C5",
          "risk_name": "Discriminatory effects on data subjects",
          "risk_status": "not_applicable",
          "likelihood": null,
          "severity": null,
          "risk_score": null,
          "mitigation": null
        },
        {
          "risk_id": "C6",
          "risk_name": "Cross-border transfer without adequate safeguards",
          "risk_status": "not_applicable",
          "likelihood": null,
          "severity": null,
          "risk_score": null,
          "mitigation": null
        }
      ]
    },
    {
      "id": "section_d_mitigation",
      "title": "Section D — Mitigation Measures",
      "fields": {
        "technical_measures": "<operator-owned-technical-measures>",
        "organizational_measures": "<operator-owned-organizational-measures>",
        "residual_risk_summary": "<operator-to-summarize-residual-risk>",
        "operator_owned_measures": "Operator owns deployment configuration, access controls, encryption, key management, retention enforcement, and incident response."
      }
    },
    {
      "id": "section_e_consultation",
      "title": "Section E — Consultation Evidence",
      "fields": {
        "dpo_advice_status": "not_applicable_repo_baseline",
        "data_subject_views_status": "not_applicable_repo_baseline",
        "supervisory_authority_prior_consultation_status": "not_applicable_repo_baseline",
        "consultation_evidence_reference": "<operator-to-record-consultation-evidence-reference>"
      }
    },
    {
      "id": "section_f_decision_approval",
      "title": "Section F — Decision and Approval",
      "fields": {
        "operator_decision_record": "<operator-to-record-decision>",
        "operator_decision_date": "<operator-to-record-date>",
        "operator_approver_role": "<operator-approver-role>",
        "operator_review_cadence": "<operator-to-define-review-cadence>"
      }
    }
  ]
}
